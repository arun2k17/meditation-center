---
const { title = 'Northwest Meditation Center', description = 'Theravada Buddhist retreats for quiet, reflection, and community.' } = Astro.props;
import { withBase } from '../utils/paths';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f4eb" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/lotus.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={withBase('/')} aria-label="Northwest Meditation Center home">
          <img src={withBase('/lotus.svg')} alt="" width="44" height="44" />
          <span><strong>Northwest</strong><small>Meditation Center</small></span>
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav" aria-label="Main navigation">
          <a href={withBase('/about')}>About</a>
          <a href={withBase('/retreats')}>Retreats</a>
          <a href={withBase('/teachings')}>Teachings</a>
          <a href={withBase('/contact')}>Contact</a>
          <a href={withBase('/support')}>Support</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <small>© 2026 Northwest Meditation Center</small>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#site-nav');
      toggle?.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        nav?.classList.toggle('is-open', !expanded);
      });
    </script>
  </body>
</html>
