---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import content from '../../content/home.json';
import { withBase } from '../utils/paths';
---
<BaseLayout description={content.description}>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow">Theravada Buddhist retreats</p><h1>{content.headingFirst}<br /><em>{content.headingSecond}</em></h1><p class="hero-intro">{content.introduction}</p><div class="hero-actions"><a class="button button-dark" href={withBase('/retreats')}>Explore retreats <span aria-hidden="true">→</span></a><a class="text-link" href={withBase('/about')}>About the center</a></div></div>
    <div class="hero-art" aria-label="Illustration of a quiet temple courtyard at dawn" role="img"><div class="sun"></div><div class="mountain mountain-back"></div><div class="mountain mountain-front"></div><div class="temple"><div class="roof roof-top"></div><div class="roof roof-mid"></div><div class="temple-body"><div class="temple-door"></div></div><div class="temple-base"></div></div><div class="reflection"></div><img class="hero-floral" src={withBase('/thai-lotus-branch.svg')} alt="" aria-hidden="true" /><span class="art-caption">{content.artCaption}</span></div>
  </section>
  <div class="hero-gathering section-wrap"><span class="dot"></span><span><strong>Upcoming retreat</strong><br />December 4–6, 2026 · 3 days</span><a href={withBase('/retreats')} aria-label="See upcoming retreats">↗</a></div>
  <section class="welcome section-wrap"><div class="section-heading"><p class="eyebrow">A welcoming community</p><h2>{content.welcomeHeading}</h2></div><p>{content.welcomeText}</p></section>
  <section class="three-cards retreat-options section-wrap" aria-label="Retreat formats"><article class="feature-card"><span class="card-icon">◌</span><span class="card-kicker">A few days away</span><h3>{content.shortRetreatTitle}</h3><p>{content.shortRetreatText}</p><a class="card-arrow" href={withBase('/retreats')}>View retreats&nbsp; →</a></article><article class="feature-card"><span class="card-icon">❋</span><span class="card-kicker">Time to settle in</span><h3>{content.longRetreatTitle}</h3><p>{content.longRetreatText}</p><a class="card-arrow" href={withBase('/retreats')}>View retreats&nbsp; →</a></article></section>
  <section class="quote-band"><p class="eyebrow">Retreats at Northwest</p><h2>{content.retreatNote}</h2></section>
  <section class="support-strip section-wrap"><div><p class="eyebrow">Planning a retreat visit?</p><h2>Questions are welcome.</h2><p>Read the retreat FAQ or contact the center.</p></div><a class="button button-outline" href={withBase('/faq')}>Read retreat FAQ <span aria-hidden="true">→</span></a></section>
</BaseLayout>
