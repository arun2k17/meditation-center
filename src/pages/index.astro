---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import { withBase } from '../utils/paths';
---
<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Theravada meditation · Bellingham, Washington</p>
      <h1>A practical path to<br /><em>lasting change.</em></h1>
      <p class="hero-intro">We support the spiritual practice of wisdom and the study and practice of Theravada meditation.</p>
      <div class="hero-actions"><a class="button button-dark" href={withBase('/retreats')}>Explore retreats <span aria-hidden="true">→</span></a><a class="text-link" href={withBase('/about')}>About the center</a></div>
      <div class="next-gathering"><span class="dot"></span><span><strong>Next proposed retreat</strong><br />Dec 4–6, 2026 · about 3 days</span><a href={withBase('/retreats')} aria-label="See retreat information">↗</a></div>
    </div>
    <div class="hero-art">
      <img class="hero-photo" src={withBase('/images/center-entrance.jpg')} alt="The Northwest Meditation Center entrance, framed by trees and gardens" fetchpriority="high" />
      <div class="hero-photo-tint" aria-hidden="true"></div><img class="hero-floral" src={withBase('/thai-lotus-branch.svg')} alt="" aria-hidden="true" /><span class="art-caption">Northwest Meditation Center · Bellingham, WA</span>
    </div>
  </section>

  <section class="welcome section-wrap">
    <div class="section-heading"><p class="eyebrow">A welcoming community</p><h2>Take time to step away.</h2></div>
    <p>We are a registered nonprofit organization established to support the spiritual practice of wisdom and promote Theravada meditation. Our Practical Approach helps create sustainable personal transformation.</p>
  </section>

  <section class="place-showcase section-wrap" aria-label="The center and its grounds">
    <div class="showcase-copy"><p class="eyebrow">A place to practice</p><h2>Rooted in the Pacific Northwest.</h2><p>Our center is in Bellingham, Washington. Learn about the center, the teachings, and upcoming retreats.</p><a class="text-link" href={withBase('/about')}>Discover the center →</a></div>
    <figure class="showcase-image showcase-main"><img src={withBase('/images/center-grounds.jpg')} alt="A view of the center and its tree-lined grounds" loading="lazy" /></figure>
    <figure class="showcase-image showcase-shrine"><img src={withBase('/images/shrine-flowers.jpg')} alt="A Buddha statue and flower offerings at the center" loading="lazy" /></figure>
    <figure class="showcase-image showcase-woods"><img src={withBase('/images/garden-trees.jpg')} alt="Mature trees on the center grounds" loading="lazy" /></figure>
  </section>

  <section class="three-cards retreat-options section-wrap" aria-label="Retreat formats under consideration">
    <article class="feature-card"><span class="card-icon">◌</span><span class="card-kicker">Format under consideration</span><h3>Short retreat</h3><p>A retreat of around three days is one option being explored. Dates and details are not confirmed.</p><a class="card-arrow" href={withBase('/retreats')}>Retreat information&nbsp; →</a></article>
    <article class="feature-card"><span class="card-icon">❋</span><span class="card-kicker">Format under consideration</span><h3>Long retreat</h3><p>A retreat of around five days is also being considered. Dates and details are not confirmed.</p><a class="card-arrow" href={withBase('/retreats')}>Retreat information&nbsp; →</a></article>
  </section>

  <section class="quote-band"><p class="eyebrow">Retreat details in development</p><h2>Dates, arrangements, and program information will be shared here.</h2></section>

  <section class="support-strip section-wrap"><div><p class="eyebrow">Planning a retreat visit?</p><h2>Questions are welcome.</h2><p>Read the retreat FAQ or contact the center for general information.</p></div><a class="button button-outline" href={withBase('/faq')}>Read retreat FAQ <span aria-hidden="true">→</span></a></section>
</BaseLayout>
