---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import content from '../../content/home.json';
import { withBase } from '../utils/paths';
---
<BaseLayout description={content.description}>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow">Theravada Buddhist center</p><h1>{content.heading}</h1><p class="hero-intro">{content.introduction}</p><div class="hero-actions"><a class="button button-dark" href={withBase('/retreats')}>Explore retreats <span aria-hidden="true">→</span></a><a class="text-link" href={withBase('/about')}>About the center</a></div></div>
    <div class="hero-art" aria-label="Illustration of a quiet temple courtyard at dawn" role="img"><div class="sun"></div><div class="mountain mountain-back"></div><div class="mountain mountain-front"></div><div class="temple"><div class="roof roof-top"></div><div class="roof roof-mid"></div><div class="temple-body"><div class="temple-door"></div></div><div class="temple-base"></div></div><div class="reflection"></div><img class="hero-floral" src={withBase('/thai-lotus-branch.svg')} alt="" aria-hidden="true" /><span class="art-caption">{content.artCaption}</span></div>
  </section>
  <section class="welcome section-wrap"><div class="section-heading"><p class="eyebrow">A welcoming community</p><h2>{content.welcomeHeading}</h2></div><p>{content.welcomeText}</p></section>
  <section class="quote-band"><p class="eyebrow">Retreats</p><h2>{content.retreatNote}</h2></section>
  <section class="support-strip section-wrap"><div><p class="eyebrow">Northwest Meditation Center</p><h2>Learn more about the center.</h2><p>Explore the center’s background and current information.</p></div><a class="button button-outline" href={withBase('/about')}>About us <span aria-hidden="true">→</span></a></section>
</BaseLayout>
