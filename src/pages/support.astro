---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import { withBase } from '../utils/paths';
const donationUrl = 'mailto:nwmeditationcenter@gmail.com?subject=Supporting%20Northwest%20Meditation%20Center';
---
<BaseLayout title="Support | Northwest Meditation Center">
  <section class="page-hero"><FloralAccent /><p class="eyebrow">Dana · generosity</p><h1>Support the<br /><em>center.</em></h1><p>Generosity helps sustain the center and support the study and practice of Theravada meditation.</p></section>
  <section class="donation-section support-page"><div class="donation-inner"><div><p class="eyebrow">Ways to give</p><h2>Offer support</h2><p>For information about supporting Northwest Meditation Center, contact us directly.</p></div><a class="button button-light" href={donationUrl}>Ask about supporting the center <span aria-hidden="true">↗</span></a></div></section>
  <section class="section-wrap support-note"><p>Questions about supporting the center? <a class="text-link" href={withBase('/contact')}>Contact us →</a></p></section>
</BaseLayout>
