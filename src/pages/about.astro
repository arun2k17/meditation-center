---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import content from '../../content/about.json';
---
<BaseLayout title="About | Northwest Meditation Center" description={content.description}>
  <section class="page-hero"><FloralAccent /><p class="eyebrow">About the center</p><h1>{content.heading}</h1><p>{content.introduction}</p></section>
  <section class="content-grid section-wrap"><div><p class="eyebrow">Our intention</p><h2>A welcoming place for retreats</h2></div><div class="prose"><p>{content.body}</p></div></section>
  <section class="people-section"><div class="section-wrap"><p class="eyebrow">Guidance &amp; care</p><h2>Teachers and board</h2><p class="prose">{content.peopleNote}</p></div></section>
</BaseLayout>
