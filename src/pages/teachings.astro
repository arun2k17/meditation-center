---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import content from '../../content/teachings.json';
---
<BaseLayout title="Teachings | Northwest Meditation Center" description={content.description}>
  <section class="page-hero"><FloralAccent /><p class="eyebrow">Talks &amp; articles</p><h1>{content.headingFirst}<br /><em>{content.headingSecond}</em></h1><p>{content.introduction}</p></section>
  <section class="section-wrap teachings-section"><div class="section-title-row"><div><p class="eyebrow">From the center</p><h2>Talks and articles</h2></div></div>
    {content.items.length ? <div class="teachings-grid">{content.items.map((item) => <article class="teaching-card"><div class={`teaching-art ${item.className}`} aria-hidden="true"><span>{item.symbol}</span></div><div class="teaching-body"><p class="eyebrow">{item.kind}</p><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div> : <p class="prose">{content.emptyMessage}</p>}
  </section>
</BaseLayout>
