---
import BaseLayout from '../layouts/BaseLayout.astro';
const resources = [
  { kind: 'Talk · Video', title: 'An introduction to the Buddha’s path', description: 'A sample talk entry. Add the teacher, date, and approved video link when available.', className: 'teaching-one', symbol: '▶' },
  { kind: 'Article', title: 'The practice of generosity', description: 'A sample article entry. Replace this copy with an approved teaching.', className: 'teaching-two', symbol: '❋' },
  { kind: 'Talk · Video', title: 'Understanding the Four Noble Truths', description: 'A sample talk entry. Add the teacher, date, and approved video link when available.', className: 'teaching-three', symbol: '▶' },
];
---
<BaseLayout title="Teachings | Northwest Meditation Center" description="Talks and articles from Northwest Meditation Center.">
  <section class="page-hero"><p class="eyebrow">Talks &amp; articles</p><h1>Explore the<br /><em>teachings.</em></h1><p>Recordings and written reflections will be gathered here as the center shares them.</p></section>
  <section class="section-wrap teachings-section"><div class="section-title-row"><div><p class="eyebrow">From the center</p><h2>Talks and articles</h2></div><span class="soft-label">Sample entries</span></div><div class="teachings-grid">{resources.map((item) => <article class="teaching-card"><div class={`teaching-art ${item.className}`} aria-hidden="true"><span>{item.symbol}</span></div><div class="teaching-body"><p class="eyebrow">{item.kind}</p><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div><p class="placeholder-note">Sample titles and descriptions only. Add verified articles and links before publishing.</p></section>
</BaseLayout>
