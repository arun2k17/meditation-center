---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Contact | Northwest Meditation Center">
  <section class="page-hero"><FloralAccent /><p class="eyebrow">Get in touch</p><h1>We’d be glad<br /><em>to hear from you.</em></h1><p>Questions about the retreat plans, accessibility, or the center? Contact us and we’ll be happy to help.</p></section>
  <section class="visit-grid section-wrap"><div class="visit-card"><p class="eyebrow">Our location</p><h2>Bellingham, Washington</h2><p>Northwest Meditation Center is located in Bellingham, WA.</p><figure class="contact-photo"><img src={withBase('/images/center-entrance.jpg')} alt="The center entrance surrounded by garden plantings" loading="lazy" /></figure></div><div class="visit-card" id="contact"><p class="eyebrow">Say hello</p><h2>Contact us</h2><dl class="contact-list"><div><dt>Email</dt><dd><a href="mailto:nwmeditationcenter@gmail.com">nwmeditationcenter@gmail.com</a></dd></div><div><dt>Phone</dt><dd><a href="tel:+14257731789">(425) 773-1789</a></dd></div></dl><p><a class="text-link" href="https://www.facebook.com/NWmeditationcenter" target="_blank" rel="noopener noreferrer">Follow Northwest Meditation Center on Facebook ↗</a></p><div class="first-visit"><h3>Retreat details</h3><p>Contact the center for retreat and visit information.</p></div></div></section>
</BaseLayout>
