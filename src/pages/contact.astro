---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
---
<BaseLayout title="Contact | Northwest Meditation Center">
  <section class="page-hero"><FloralAccent /><p class="eyebrow">Get in touch</p><h1>We’d be glad<br /><em>to hear from you.</em></h1><p>Questions about the retreat plans, accessibility, or the center? Contact us and we’ll be happy to help.</p></section>
  <section class="visit-grid section-wrap"><div class="visit-card"><p class="eyebrow">Our location</p><h2>Find the center</h2><p>123 Stillwater Road<br />Sample City, CA 90000</p><p>Address, arrival instructions, and accessibility information will be confirmed for each retreat.</p><a class="text-link" href="https://maps.google.com/?q=123+Stillwater+Road">Open directions ↗</a><div class="map-placeholder" aria-label="Map placeholder"><span>⌖</span><small>Center location</small></div></div><div class="visit-card" id="contact"><p class="eyebrow">Say hello</p><h2>Contact us</h2><dl class="contact-list"><div><dt>Email</dt><dd><a href="mailto:hello@example.org">hello@example.org</a></dd></div><div><dt>Phone</dt><dd><a href="tel:+15555550123">(555) 555-0123</a></dd></div><div><dt>Visit hours</dt><dd>To be confirmed with retreat details</dd></div></dl><div class="first-visit"><h3>Retreat details</h3><p>Arrival time, accommodations, meals, and what to bring will be shared when each retreat is announced.</p></div></div></section>
</BaseLayout>
