---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import content from '../../content/contact.json';
---
<BaseLayout title="Contact | Northwest Meditation Center" description={content.description}>
  <section class="page-hero"><FloralAccent /><p class="eyebrow">Get in touch</p><h1>{content.heading}</h1><p>{content.introduction}</p></section>
  <section class="visit-grid section-wrap"><div class="visit-card"><p class="eyebrow">Location</p><h2>Visit the center</h2><p>{content.locationNote}</p></div><div class="visit-card" id="contact"><p class="eyebrow">Contact</p><h2>Reach us</h2><p>{content.contactNote}</p></div></section>
</BaseLayout>
