---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
import FloralAccent from '../components/FloralAccent.astro';
const months = [
  {
    name: 'December 2026',
    retreats: [
      { format: 'Short retreat', start: '2026-12-04', startLabel: 'Fri, Dec 4', end: '2026-12-06', endLabel: 'Sun, Dec 6', length: '3 days' },
      { format: 'Long retreat', start: '2026-12-18', startLabel: 'Fri, Dec 18', end: '2026-12-22', endLabel: 'Tue, Dec 22', length: '5 days' },
    ],
  },
  {
    name: 'January 2027',
    retreats: [
      { format: 'Short retreat', start: '2027-01-08', startLabel: 'Fri, Jan 8', end: '2027-01-10', endLabel: 'Sun, Jan 10', length: '3 days' },
      { format: 'Long retreat', start: '2027-01-22', startLabel: 'Fri, Jan 22', end: '2027-01-26', endLabel: 'Tue, Jan 26', length: '5 days' },
    ],
  },
];
---
<BaseLayout title="Retreats | Northwest Meditation Center" description="Retreat program information and planning updates from Northwest Meditation Center.">
  <section class="page-hero"><FloralAccent /><p class="eyebrow">Retreats at Northwest</p><h1>Time away for<br /><em>quiet reflection.</em></h1><p>We are planning a retreat program rooted in the Theravada Buddhist tradition. The dates below are sample proposals for review.</p></section>

  <section class="section-wrap retreat-page-section">
    <div class="section-title-row"><div><p class="eyebrow">A sample two-month view</p><h2>Upcoming retreats</h2></div><span class="soft-label">Tentative dates</span></div>
    <p class="retreat-lead">The draft plan shows one short and one long retreat each month. All dates and event details below are illustrative and have not been confirmed.</p>
    {months.map((month) => <section class="retreat-month" aria-labelledby={`month-${month.name.replaceAll(' ', '-')}`}>
      <h3 id={`month-${month.name.replaceAll(' ', '-')}`}>{month.name}</h3>
      <div class="upcoming-retreats">{month.retreats.map((retreat) => <article class="upcoming-retreat-card">
        <p class="retreat-card-kicker"><span aria-hidden="true">✿</span> Proposed · {retreat.format}</p>
        <p class="retreat-date"><time datetime={retreat.start}>{retreat.startLabel}</time><span aria-hidden="true"> — </span><time datetime={retreat.end}>{retreat.endLabel}</time></p>
        <p class="retreat-length">{retreat.length}</p>
        <p class="retreat-card-note">Location, arrival details, and registration to be confirmed.</p>
      </article>)}</div>
    </section>)}
    <p class="placeholder-note">Sample schedule only. Frequency, dates, capacity, accommodations, meals, fees, and program details remain undecided.</p>
  </section>

  <section class="retreat-banner" style={`--retreat-image: url('${withBase('/images/retreat-grounds.jpg')}')`}><div class="section-wrap retreat-inner"><div><p class="eyebrow">Interested in attending?</p><h2>Join us for a retreat.</h2><p>Contact the center for registration details and information about your visit.</p></div><a class="button button-light" href="mailto:nwmeditationcenter@gmail.com?subject=Retreat%20registration">Email about retreats <span aria-hidden="true">↗</span></a></div></section>
  <section class="section-wrap signup-note" id="signup"><a class="text-link" href={withBase('/faq')}>Read retreat FAQ →</a></section>
</BaseLayout>
