---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import content from '../../content/retreats.json';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Retreats | Northwest Meditation Center" description={content.description}>
  <section class="page-hero"><FloralAccent /><p class="eyebrow">Retreats at Northwest</p><h1>{content.heading}</h1><p>{content.introduction}</p></section>
  <section class="section-wrap retreat-page-section">
    <div class="section-title-row"><div><p class="eyebrow">Retreat program</p><h2>Upcoming retreats</h2></div></div>
    {content.retreats.length ? <div class="upcoming-retreats">{content.retreats.map((retreat) => <article class="upcoming-retreat-card"><p class="retreat-card-kicker"><span aria-hidden="true">✿</span> {retreat.format}</p><h3>{retreat.title}</h3><p class="retreat-date"><time datetime={retreat.startDate}>{retreat.dateLabel}</time></p>{retreat.description && <p>{retreat.description}</p>}{retreat.registrationUrl && <a class="text-link" href={retreat.registrationUrl}>Registration information ↗</a>}</article>)}</div> : <p class="prose">{content.emptyMessage}</p>}
    <p><a class="text-link" href={withBase('/faq')}>Retreat FAQ →</a></p>
  </section>
</BaseLayout>
