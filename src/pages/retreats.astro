---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloralAccent from '../components/FloralAccent.astro';
import content from '../../content/retreats.json';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Retreats | Northwest Meditation Center" description={content.description}>
  <section class="page-hero"><FloralAccent /><p class="eyebrow">Retreats at Northwest</p><h1>{content.headingFirst}<br /><em>{content.headingSecond}</em></h1><p>{content.introduction}</p></section>
  <section class="section-wrap retreat-page-section">
    <div class="section-title-row"><div><p class="eyebrow">Upcoming retreats</p><h2>Find time to pause</h2></div></div>
    {content.months.map((month) => <section class="retreat-month" aria-labelledby={`month-${month.name.replaceAll(' ', '-')}`}><h3 id={`month-${month.name.replaceAll(' ', '-')}`}>{month.name}</h3><div class="upcoming-retreats">{month.retreats.map((retreat) => <article class="upcoming-retreat-card"><p class="retreat-card-kicker"><span aria-hidden="true">✿</span> {retreat.format}</p><h4>{retreat.title}</h4><p class="retreat-date"><time datetime={retreat.startDate}>{retreat.startLabel}</time><span aria-hidden="true"> — </span><time datetime={retreat.endDate}>{retreat.endLabel}</time></p><p class="retreat-length">{retreat.length}</p><a class="text-link" href={withBase('/contact#contact')}>Register your interest →</a></article>)}</div></section>)}
    <p class="retreat-lead">{content.registrationText}</p>
    <p><a class="text-link" href={withBase('/faq')}>Read the retreat FAQ →</a></p>
  </section>
</BaseLayout>
